# wombat-go environment. Copy to .env (gitignored) and fill in.
#
# Every one of these is a default that Config fields override in code.
# ConfigFromEnv() reads them; New() never reads the environment behind your
# back beyond the API key.

# ── which provider the CLI defaults to ─────────────────────────────────
# "openai" (any OpenAI-compatible /v1/chat/completions endpoint) or
# "anthropic" (/v1/messages).
export WOMBAT_PROVIDER="openai"

# Default model for whichever provider is selected. Provider-specific
# OPENAI_MODEL / ANTHROPIC_MODEL take priority over this.
export WOMBAT_MODEL="gpt-4o-mini"

# ── OpenAI-compatible leaf ─────────────────────────────────────────────
# Give the origin plus the /v1 prefix; "/chat/completions" is appended.
export OPENAI_BASE_URL="https://api.openai.com/v1"

# HTTP proxy as "host:port" or a full URL. A bare host:port is normalised to
# http://host:port, which is the form curl -x takes.
# export OPENAI_PROXY="localhost:3128"

# Sent as "Authorization: Bearer ...". A gateway that injects its own
# credential still needs a non-empty placeholder here; an empty value omits
# the header entirely, which is what local vLLM and Ollama want.
export OPENAI_API_KEY=""

# Newline-separated "Name: value" lines, applied last.
# export OPENAI_EXTRA_HEADERS="X-Client-Name: wombat-go
# X-Client-Version: 0.1.0"

# auto | always | never.
#
# "auto" (the default) streams whenever a caller supplies a delta sink, which
# the agent loop always does. Some gateways drop the usage record from a
# streamed reply — if token accounting and budgets matter more than live
# output, force "never".
# export OPENAI_STREAM="auto"

# ── Anthropic leaf ─────────────────────────────────────────────────────
# AGENT_LLM_BASE_URL / AGENT_LLM_PROXY are honoured as fallbacks.
# export ANTHROPIC_BASE_URL="https://api.anthropic.com"
# export ANTHROPIC_PROXY="localhost:3128"
export ANTHROPIC_API_KEY=""

# Comma-separated beta flags. The context-management beta is required whenever
# the request carries a context_management block.
# export ANTHROPIC_BETA="context-management-2025-06-27"

# export ANTHROPIC_CUSTOM_HEADERS="X-Client-Name: wombat-go"
# export ANTHROPIC_STREAM="auto"
